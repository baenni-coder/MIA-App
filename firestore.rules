rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // Helper Functions
    // ============================================

    // Prüft ob User authentifiziert ist
    function isAuthenticated() {
      return request.auth != null;
    }

    // Prüft ob User der Besitzer ist
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Holt Teacher Profil
    function getTeacher(userId) {
      return get(/databases/$(database)/documents/teachers/$(userId));
    }

    // Prüft ob User PICTS-Admin ist
    function isPICTSAdmin(userId) {
      let teacher = getTeacher(userId);
      return teacher.data.role == "picts_admin" || teacher.data.role == "super_admin";
    }

    // Prüft ob User Super-Admin ist
    function isSuperAdmin(userId) {
      let teacher = getTeacher(userId);
      return teacher.data.role == "super_admin";
    }

    // Prüft ob User PICTS-Admin der angegebenen Schule ist
    function isPICTSAdminOfSchule(userId, schuleId) {
      let teacher = getTeacher(userId);
      return (teacher.data.role == "picts_admin" || teacher.data.role == "super_admin")
             && teacher.data.schuleId == schuleId;
    }

    // ============================================
    // Teachers Collection
    // ============================================

    match /teachers/{userId} {
      // Lesen: Nur eigenes Profil
      allow read: if isAuthenticated() && isOwner(userId);

      // Erstellen: Jeder authentifizierte User kann sein Profil erstellen
      allow create: if isAuthenticated() && isOwner(userId)
                    && request.resource.data.role == "teacher"; // Standardrolle

      // Aktualisieren: Eigenes Profil, aber role nur durch Super-Admin
      allow update: if isAuthenticated() && (
        // Normale Updates (stufe, etc.)
        (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["role"])) ||
        // Role-Updates nur durch Super-Admin
        (isSuperAdmin(request.auth.uid))
      );

      // Löschen: Nur Super-Admin
      allow delete: if isAuthenticated() && isSuperAdmin(request.auth.uid);
    }

    // ============================================
    // Custom Themes Collection
    // ============================================

    match /custom_themes/{themeId} {
      // Lesen: Ersteller, systemweite Themen, oder PICTS-Admin der Schule
      allow read: if isAuthenticated() && (
        resource.data.createdBy == request.auth.uid ||
        resource.data.isSystemWide == true ||
        isPICTSAdminOfSchule(request.auth.uid, resource.data.schuleId)
      );

      // Erstellen: Jeder authentifizierte User
      allow create: if isAuthenticated()
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.isSystemWide == false
                    && request.resource.data.status in ["draft", "pending_review"];

      // Aktualisieren:
      // - Ersteller kann sein eigenes Thema bearbeiten
      // - PICTS-Admin kann Status ändern (für Review)
      allow update: if isAuthenticated() && (
        // Ersteller kann bearbeiten
        (resource.data.createdBy == request.auth.uid
         && request.resource.data.createdBy == resource.data.createdBy) ||
        // PICTS-Admin kann reviewen
        isPICTSAdminOfSchule(request.auth.uid, resource.data.schuleId)
      );

      // Löschen: Nur Ersteller (nur draft) oder Super-Admin
      allow delete: if isAuthenticated() && (
        (resource.data.createdBy == request.auth.uid && resource.data.status == "draft") ||
        isSuperAdmin(request.auth.uid)
      );
    }

    // ============================================
    // Custom Lektionen Collection
    // ============================================

    match /custom_lektionen/{lektionId} {
      // Helper: Prüft ob User Zugriff auf das zugehörige Theme hat
      function canAccessTheme(themeId) {
        let theme = get(/databases/$(database)/documents/custom_themes/$(themeId));
        return theme.data.createdBy == request.auth.uid ||
               theme.data.isSystemWide == true ||
               isPICTSAdminOfSchule(request.auth.uid, theme.data.schuleId);
      }

      // Lesen: Theme-Lektionen wenn User das Theme lesen darf; Einheit-Lektionen
      // wenn User die Lektion erstellt hat (Owner der Einheit). Der Haupt-Zugriff
      // läuft ohnehin über die API (Admin SDK umgeht Rules).
      allow read: if isAuthenticated() && (
        (resource.data.themeId != null && canAccessTheme(resource.data.themeId)) ||
        (resource.data.einheitId != null && resource.data.createdBy == request.auth.uid)
      );

      // Erstellen: Theme-Lektion (User besitzt Theme) ODER Einheit-Lektion
      // (User besitzt die zugehörige Jahresplan-Einheit).
      allow create: if isAuthenticated()
                    && request.resource.data.createdBy == request.auth.uid
                    && (
                      (request.resource.data.themeId != null
                        && exists(/databases/$(database)/documents/custom_themes/$(request.resource.data.themeId))
                        && get(/databases/$(database)/documents/custom_themes/$(request.resource.data.themeId)).data.createdBy == request.auth.uid)
                      ||
                      (request.resource.data.einheitId != null
                        && exists(/databases/$(database)/documents/jahresplanung/$(request.resource.data.einheitId))
                        && get(/databases/$(database)/documents/jahresplanung/$(request.resource.data.einheitId)).data.teacherId == request.auth.uid)
                    );

      // Aktualisieren: Nur Ersteller
      allow update: if isAuthenticated() && resource.data.createdBy == request.auth.uid;

      // Löschen: Nur Ersteller
      allow delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
    }

    // ============================================
    // School Files Collection (Metadaten für schulspezifische Dateien)
    // ============================================

    match /school_files/{fileId} {
      // Helper: Prüft ob User zur gleichen Schule gehört
      function isSameSchool(schuleId) {
        let teacher = getTeacher(request.auth.uid);
        return teacher.data.schuleId == schuleId;
      }

      // Lesen: Eigene Dateien ODER geteilte Dateien der gleichen Schule
      allow read: if isAuthenticated() && (
        resource.data.uploadedBy == request.auth.uid ||
        (resource.data.sharedWith == "school" && isSameSchool(resource.data.schuleId))
      );

      // Erstellen: Jeder authentifizierte User kann Dateien hochladen
      allow create: if isAuthenticated()
                    && request.resource.data.uploadedBy == request.auth.uid
                    && isSameSchool(request.resource.data.schuleId);

      // Aktualisieren: Nur der Uploader
      allow update: if isAuthenticated()
                    && resource.data.uploadedBy == request.auth.uid;

      // Löschen: Nur der Uploader oder PICTS-Admin der Schule
      allow delete: if isAuthenticated() && (
        resource.data.uploadedBy == request.auth.uid ||
        isPICTSAdminOfSchule(request.auth.uid, resource.data.schuleId)
      );
    }

    // ============================================
    // Notifications Collection
    // ============================================

    match /notifications/{notificationId} {
      // Lesen: Nur Empfänger
      allow read: if isAuthenticated() && resource.data.recipientId == request.auth.uid;

      // Erstellen: Jeder authentifizierte User (für System-Notifications)
      allow create: if isAuthenticated();

      // Aktualisieren: Nur Empfänger (für read-Status)
      allow update: if isAuthenticated()
                    && resource.data.recipientId == request.auth.uid
                    && request.resource.data.recipientId == resource.data.recipientId;

      // Löschen: Nur Empfänger
      allow delete: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
    }

    // ============================================
    // Students Collection (Schüler-Profile)
    // ============================================

    // Helper: Holt Student Profil
    function getStudent(userId) {
      return get(/databases/$(database)/documents/students/$(userId));
    }

    // Helper: Prüft ob User ein Schüler ist
    function isStudent(userId) {
      return exists(/databases/$(database)/documents/students/$(userId));
    }

    // Helper: Prüft ob Lehrer Zugriff auf Schüler hat
    function teacherHasStudentAccess(teacherId, studentId) {
      let student = getStudent(studentId);
      return student.data.teacherId == teacherId;
    }

    match /students/{studentId} {
      // Lesen: Eigenes Profil oder zuständiger Lehrer oder Admin
      allow read: if isAuthenticated() && (
        isOwner(studentId) ||
        (exists(/databases/$(database)/documents/teachers/$(request.auth.uid)) &&
         resource.data.teacherId == request.auth.uid) ||
        isPICTSAdmin(request.auth.uid)
      );

      // Erstellen: Nur Lehrer (über API)
      allow create: if false; // Nur über Admin SDK

      // Aktualisieren: Nur Lehrer des Schülers
      allow update: if isAuthenticated() &&
        exists(/databases/$(database)/documents/teachers/$(request.auth.uid)) &&
        resource.data.teacherId == request.auth.uid;

      // Löschen: Nur Lehrer des Schülers oder Admin
      allow delete: if isAuthenticated() && (
        (exists(/databases/$(database)/documents/teachers/$(request.auth.uid)) &&
         resource.data.teacherId == request.auth.uid) ||
        isSuperAdmin(request.auth.uid)
      );
    }

    // ============================================
    // Classes Collection (Schulklassen)
    // ============================================

    match /classes/{classId} {
      // Lesen: Klassenlehrer, Schüler der Klasse, oder Admin
      allow read: if isAuthenticated() && (
        resource.data.teacherId == request.auth.uid ||
        (isStudent(request.auth.uid) &&
         getStudent(request.auth.uid).data.classId == classId) ||
        isPICTSAdmin(request.auth.uid)
      );

      // Erstellen: Nur Lehrer
      allow create: if isAuthenticated() &&
        exists(/databases/$(database)/documents/teachers/$(request.auth.uid)) &&
        request.resource.data.teacherId == request.auth.uid;

      // Aktualisieren: Nur Klassenlehrer
      allow update: if isAuthenticated() &&
        resource.data.teacherId == request.auth.uid;

      // Löschen: Nur Klassenlehrer oder Admin
      allow delete: if isAuthenticated() && (
        resource.data.teacherId == request.auth.uid ||
        isSuperAdmin(request.auth.uid)
      );
    }

    // ============================================
    // Student Progress Collection (Schüler-Bewertungen)
    // ============================================

    match /student_progress/{progressId} {
      // Lesen: Eigene Bewertungen oder zuständiger Lehrer
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        (exists(/databases/$(database)/documents/teachers/$(request.auth.uid)) &&
         teacherHasStudentAccess(request.auth.uid, resource.data.studentId))
      );

      // Erstellen: Nur der Schüler selbst
      allow create: if isAuthenticated() &&
        isStudent(request.auth.uid) &&
        request.resource.data.studentId == request.auth.uid;

      // Aktualisieren: Schüler (Bewertungen) oder Lehrer (Kommentare)
      allow update: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        (exists(/databases/$(database)/documents/teachers/$(request.auth.uid)) &&
         teacherHasStudentAccess(request.auth.uid, resource.data.studentId))
      );

      // Löschen: Nur Admin
      allow delete: if isAuthenticated() && isSuperAdmin(request.auth.uid);
    }

    // ============================================
    // Class Theme Progress Collection (Bearbeitete Themen)
    // ============================================

    match /class_theme_progress/{progressId} {
      // Lesen: Klassenlehrer oder Schüler der Klasse
      allow read: if isAuthenticated() && (
        resource.data.markedCompletedBy == request.auth.uid ||
        (isStudent(request.auth.uid) &&
         getStudent(request.auth.uid).data.classId == resource.data.classId)
      );

      // Erstellen: Nur Klassenlehrer
      allow create: if isAuthenticated() &&
        exists(/databases/$(database)/documents/teachers/$(request.auth.uid)) &&
        request.resource.data.markedCompletedBy == request.auth.uid;

      // Aktualisieren: Nur der markierende Lehrer
      allow update: if isAuthenticated() &&
        resource.data.markedCompletedBy == request.auth.uid;

      // Löschen: Nur der markierende Lehrer oder Admin
      allow delete: if isAuthenticated() && (
        resource.data.markedCompletedBy == request.auth.uid ||
        isSuperAdmin(request.auth.uid)
      );
    }

    // ============================================
    // Badges Collection (Badge-Definitionen)
    // ============================================

    match /badges/{badgeId} {
      // Lesen: Alle authentifizierten User
      allow read: if isAuthenticated();

      // Erstellen: Nur Lehrer (Custom Badges)
      allow create: if isAuthenticated() &&
        exists(/databases/$(database)/documents/teachers/$(request.auth.uid));

      // Aktualisieren: Nur Ersteller oder Admin
      allow update: if isAuthenticated() && (
        resource.data.createdBy == request.auth.uid ||
        isSuperAdmin(request.auth.uid)
      );

      // Löschen: Nur Ersteller oder Admin
      allow delete: if isAuthenticated() && (
        (resource.data.createdBy == request.auth.uid && resource.data.isSystem == false) ||
        isSuperAdmin(request.auth.uid)
      );
    }

    // ============================================
    // Student Badges Collection (Vergebene Badges)
    // ============================================

    match /student_badges/{badgeId} {
      // Lesen: Eigene Badges oder Lehrer
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        exists(/databases/$(database)/documents/teachers/$(request.auth.uid))
      );

      // Erstellen: System oder Lehrer
      allow create: if isAuthenticated() &&
        exists(/databases/$(database)/documents/teachers/$(request.auth.uid));

      // Aktualisieren: Nur für notified Flag durch Schüler
      allow update: if isAuthenticated() &&
        resource.data.studentId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["notified"]);

      // Löschen: Nur Admin
      allow delete: if isAuthenticated() && isSuperAdmin(request.auth.uid);
    }

    // ============================================
    // Student Notifications Collection
    // ============================================

    match /student_notifications/{notificationId} {
      // Lesen: Nur der Schüler
      allow read: if isAuthenticated() && resource.data.studentId == request.auth.uid;

      // Erstellen: System oder Lehrer
      allow create: if isAuthenticated();

      // Aktualisieren: Nur für isRead durch Schüler
      allow update: if isAuthenticated() &&
        resource.data.studentId == request.auth.uid;

      // Löschen: Nur der Schüler oder Admin
      allow delete: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        isSuperAdmin(request.auth.uid)
      );
    }

    // ============================================
    // Jahresplanung Collection (Fächerübergreifende Planung)
    // ============================================

    match /jahresplanung/{einheitId} {
      // Lesen: Eigene Einheiten oder geteilte Einheiten derselben Schule
      allow read: if isAuthenticated() && (
        resource.data.teacherId == request.auth.uid ||
        (resource.data.isShared == true &&
         exists(/databases/$(database)/documents/teachers/$(request.auth.uid)) &&
         getTeacher(request.auth.uid).data.schuleId == resource.data.schuleId)
      );

      // Erstellen: Jeder authentifizierte Lehrer
      allow create: if isAuthenticated() &&
        exists(/databases/$(database)/documents/teachers/$(request.auth.uid)) &&
        request.resource.data.teacherId == request.auth.uid;

      // Aktualisieren: Nur der Ersteller
      allow update: if isAuthenticated() &&
        resource.data.teacherId == request.auth.uid;

      // Löschen: Nur der Ersteller
      allow delete: if isAuthenticated() &&
        resource.data.teacherId == request.auth.uid;
    }

    // ============================================
    // Jahresplan Lektionsplanungen (mehrere Lektionsplanungen pro Einheit)
    // ============================================

    match /jahresplan_lektionsplanungen/{planungId} {
      // Lesen: Owner der Planung ODER geteilte Einheit derselben Schule.
      // Haupt-Zugriff läuft über die API (Admin SDK umgeht Rules).
      allow read: if isAuthenticated() && (
        resource.data.teacherId == request.auth.uid ||
        (resource.data.schuleId != null &&
         exists(/databases/$(database)/documents/teachers/$(request.auth.uid)) &&
         getTeacher(request.auth.uid).data.schuleId == resource.data.schuleId)
      );

      // Erstellen: Der Ersteller muss Owner der zugehörigen Einheit sein.
      allow create: if isAuthenticated()
        && request.resource.data.teacherId == request.auth.uid
        && exists(/databases/$(database)/documents/jahresplanung/$(request.resource.data.einheitId))
        && get(/databases/$(database)/documents/jahresplanung/$(request.resource.data.einheitId)).data.teacherId == request.auth.uid;

      // Aktualisieren/Löschen: Nur der Ersteller
      allow update, delete: if isAuthenticated() &&
        resource.data.teacherId == request.auth.uid;
    }

    // ============================================
    // Schulferien Custom Collection (Benutzerdefinierte Ferien)
    // ============================================

    match /schulferien_custom/{ferienId} {
      // Lesen: Eigene Ferien oder schulweite Ferien der eigenen Schule
      allow read: if isAuthenticated() && (
        resource.data.teacherId == request.auth.uid ||
        (resource.data.schuleId != null &&
         getTeacher(request.auth.uid).data.schuleId == resource.data.schuleId)
      );

      // Erstellen: Jeder authentifizierte Lehrer
      allow create: if isAuthenticated() &&
        exists(/databases/$(database)/documents/teachers/$(request.auth.uid)) &&
        request.resource.data.teacherId == request.auth.uid;

      // Aktualisieren: Nur der Ersteller
      allow update: if isAuthenticated() &&
        resource.data.teacherId == request.auth.uid;

      // Löschen: Nur der Ersteller
      allow delete: if isAuthenticated() &&
        resource.data.teacherId == request.auth.uid;
    }

    // ============================================
    // Lehrmittel Collection (von Lehrpersonen erfassbares Register)
    // ============================================

    match /lehrmittel/{lehrmittelId} {
      // Lesen: alle authentifizierten User (Filter system-/schulweit auf API-Ebene)
      allow read: if isAuthenticated();

      // Erstellen: jeder authentifizierte User als Ersteller (immer schulweit)
      allow create: if isAuthenticated()
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.isSystemWide == false;

      // Aktualisieren/Löschen: Ersteller oder Admin (systemweite Freigabe
      // wird zusätzlich im API-Layer auf Admins beschränkt)
      allow update, delete: if isAuthenticated() && (
        resource.data.createdBy == request.auth.uid ||
        isPICTSAdmin(request.auth.uid)
      );
    }

    // ============================================
    // School Jahresplan Assignments Collection
    // (Zuordnung von Pool-Themen zum Schul-Jahresplan inkl. Overrides)
    // ============================================

    match /school_jahresplan_assignments/{assignmentId} {
      // Lesen: Alle authentifizierten User (Lehrer sehen den kuratierten Jahresplan
      // ihrer Schule; die Filterung auf die eigene Schule erfolgt auf API-Ebene).
      allow read: if isAuthenticated();

      // Schreiben (Create/Update/Delete): Nur Super-Admin oder PICTS-Admin der
      // betreffenden Schule. Client-seitige Writes sind optional – der
      // Haupt-Workflow läuft über die API (Admin SDK umgeht Rules ohnehin),
      // diese Rules dienen als Sicherheitsnetz.
      allow create: if isAuthenticated() && (
        isSuperAdmin(request.auth.uid) ||
        isPICTSAdminOfSchule(request.auth.uid, request.resource.data.schuleId)
      );

      allow update: if isAuthenticated() && (
        isSuperAdmin(request.auth.uid) ||
        isPICTSAdminOfSchule(request.auth.uid, resource.data.schuleId)
      );

      allow delete: if isAuthenticated() && (
        isSuperAdmin(request.auth.uid) ||
        isPICTSAdminOfSchule(request.auth.uid, resource.data.schuleId)
      );
    }

    // ============================================
    // School Lektion Overrides Collection
    // (schulspezifische Anpassung einzelner Lektionen eines Pool-Themas)
    // ============================================

    match /school_lektion_overrides/{overrideId} {
      // Lesen: Alle authentifizierten User (Lehrpersonen sehen die angepasste
      // Lektionsplanung ihrer Schule; die Filterung erfolgt auf API-Ebene).
      allow read: if isAuthenticated();

      // Schreiben: Nur Super-Admin oder PICTS-Admin der betreffenden Schule.
      // Der Haupt-Workflow läuft über die API (Admin SDK umgeht Rules), diese
      // Rules dienen als Sicherheitsnetz.
      allow create: if isAuthenticated() && (
        isSuperAdmin(request.auth.uid) ||
        isPICTSAdminOfSchule(request.auth.uid, request.resource.data.schuleId)
      );

      allow update: if isAuthenticated() && (
        isSuperAdmin(request.auth.uid) ||
        isPICTSAdminOfSchule(request.auth.uid, resource.data.schuleId)
      );

      allow delete: if isAuthenticated() && (
        isSuperAdmin(request.auth.uid) ||
        isPICTSAdminOfSchule(request.auth.uid, resource.data.schuleId)
      );
    }
  }
}
