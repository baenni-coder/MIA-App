rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isValidImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    function isSizeValid(maxSizeMB) {
      return request.resource.size < maxSizeMB * 1024 * 1024;
    }

    // ============================================
    // Theme Images
    // ============================================

    // Pfad: themes/{userId}/{filename}
    match /themes/{userId}/{filename} {
      // Lesen: Jeder (öffentlich)
      allow read: if true;

      // Schreiben: Nur eigener User, max 10MB, nur Bilder
      allow write: if isAuthenticated()
                   && isOwner(userId)
                   && isValidImage()
                   && isSizeValid(10);

      // Löschen: Nur eigener User
      allow delete: if isAuthenticated() && isOwner(userId);
    }

    // ============================================
    // Student Artifacts (Schüler-Belege für Kompetenzen)
    // ============================================

    // Pfad: student-artifacts/{studentId}/{filename}
    match /student-artifacts/{studentId}/{filename} {
      // Lesen: Nur eigener Schüler oder authentifizierte Lehrer
      // (Lehrer-Zugriff wird serverseitig geprüft)
      allow read: if isAuthenticated();

      // Schreiben: Nur der eigene Schüler, max 20MB
      allow write: if isAuthenticated()
                   && isOwner(studentId)
                   && isSizeValid(20);

      // Löschen: Nur der eigene Schüler
      allow delete: if isAuthenticated() && isOwner(studentId);
    }

    // ============================================
    // School Files (schulspezifische Unterlagen)
    // ============================================

    // Pfad: school-files/{schuleId}/shared/{filename}
    // Für Dateien, die mit allen Lehrpersonen der Schule geteilt werden
    match /school-files/{schuleId}/shared/{filename} {
      // Lesen: Nur Lehrpersonen derselben Schule
      // (wird via Custom Claims oder Server-side geprüft)
      allow read: if isAuthenticated();

      // Schreiben: Nur authentifizierte User (Server prüft Schul-Zugehörigkeit)
      allow write: if isAuthenticated()
                   && isSizeValid(50); // Max 50MB pro Datei

      // Löschen: Nur authentifizierte User
      allow delete: if isAuthenticated();
    }

    // Pfad: school-files/{schuleId}/users/{userId}/{filename}
    // Für private Dateien eines Users (nur er selbst sieht sie)
    match /school-files/{schuleId}/users/{userId}/{filename} {
      // Lesen: Nur der Besitzer
      allow read: if isAuthenticated() && isOwner(userId);

      // Schreiben: Nur der Besitzer, max 50MB
      allow write: if isAuthenticated()
                   && isOwner(userId)
                   && isSizeValid(50);

      // Löschen: Nur der Besitzer
      allow delete: if isAuthenticated() && isOwner(userId);
    }

    // ============================================
    // Andere Dateien (falls benötigt)
    // ============================================

    // Default: Kein Zugriff
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
